/* Modern Minimalist Footer - Dark Theme */

/* Footer Container */
.footer {
  background: linear-gradient(180deg, rgba(10, 14, 20, 0.95) 0%, rgba(10, 14, 20, 1) 100%);
  border-top: 1px solid rgba(255, 204, 0, 0.1);
  color: rgba(226, 232, 240, 0.85);
  margin-top: auto;
  position: relative;
}

.footer-content {
  max-width: var(--max-content-width);
  margin: 0 auto;
  padding: clamp(1.5rem, 3vw, 2rem) clamp(1rem, 2vw, 1.5rem) clamp(1rem, 2vw, 1.25rem);
  display: flex;
  flex-direction: column;
  gap: clamp(1.25rem, 2.5vw, 1.5rem);
}

/* Footer Top Section */
.footer-top {
  display: grid;
  grid-template-columns: 1.2fr 1.8fr;
  gap: clamp(1.25rem, 2.5vw, 2rem);
  align-items: start;
}

/* Brand Area */
.brand-area {
  display: flex;
  flex-direction: column;
  gap: clamp(0.625rem, 1.5vw, 0.75rem);
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  width: max-content;
  transition: transform 0.2s ease;
}

.brand-logo:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}

.brand-logo:focus {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

.brand-logo-img {
  height: clamp(24px, 4vw, 28px);
  width: auto;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}

.brand-tagline {
  color: rgba(148, 163, 184, 0.7);
  font-size: clamp(0.75rem, 1.6vw, 0.8125rem);
  line-height: 1.5;
  max-width: 260px;
  margin: 0;
  font-weight: 400;
}

/* Company Highlights */
.company-highlights {
  display: flex;
  flex-direction: column;
  gap: clamp(0.5rem, 1.25vw, 0.625rem);
  margin-top: clamp(0.25rem, 1vw, 0.375rem);
}

.highlight-item {
  display: flex;
  align-items: center;
  gap: clamp(0.625rem, 1.5vw, 0.75rem);
  color: rgba(148, 163, 184, 0.75);
  font-size: clamp(0.75rem, 1.75vw, 0.8125rem);
  padding: clamp(0.25rem, 1vw, 0.375rem) 0;
}

.highlight-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: clamp(20px, 4vw, 24px);
  height: clamp(20px, 4vw, 24px);
  background: rgba(40, 193, 255, 0.08);
  border-radius: 4px;
  color: var(--accent);
  flex-shrink: 0;
}

.highlight-icon svg {
  width: clamp(12px, 2.5vw, 14px);
  height: clamp(12px, 2.5vw, 14px);
}

.highlight-item span {
  font-weight: 400;
}

/* Social Links */
.social-links {
  display: flex;
  gap: clamp(0.5rem, 1.2vw, 0.625rem);
  margin-top: clamp(0.5rem, 1.2vw, 0.75rem);
}

.social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: clamp(32px, 6vw, 36px);
  height: clamp(32px, 6vw, 36px);
  color: rgba(148, 163, 184, 0.7);
  background: rgba(255, 204, 0, 0.03);
  border: 1px solid rgba(255, 204, 0, 0.15);
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
}

.social-link:hover {
  color: var(--accent);
  border-color: rgba(255, 204, 0, 0.4);
  background: rgba(255, 204, 0, 0.08);
  transform: translateY(-2px);
}

.social-link:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.social-link svg {
  width: clamp(15px, 3vw, 17px);
  height: clamp(15px, 3vw, 17px);
}

/* Links Section */
.links-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(1.25rem, 2.5vw, 1.75rem);
}

.links-column {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-weight: 600;
  font-size: clamp(0.5625rem, 0.9vw, 0.625rem);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--accent, #ffcc00);
  margin-bottom: clamp(0.375rem, 0.8vw, 0.5rem);
  padding-bottom: 0;
  border-bottom: none;
  opacity: 0.95;
  line-height: 1.2;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: clamp(0.25rem, 0.8vw, 0.375rem);
}

.footer-links li {
  display: flex;
}

.footer-links a {
  color: rgba(148, 163, 184, 0.75);
  text-decoration: none;
  font-size: clamp(0.75rem, 1.6vw, 0.8125rem);
  padding: clamp(0.1875rem, 0.6vw, 0.3125rem) 0;
  font-weight: 400;
  transition: all 0.2s ease;
  position: relative;
}

.footer-links a::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 1px;
  background: var(--accent, #ffcc00);
  transition: width 0.3s ease;
}

.footer-links a:hover {
  color: rgba(226, 232, 240, 0.95);
  padding-left: 0.25rem;
}

.footer-links a:hover::before {
  width: 20px;
}

.footer-links a:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 4px;
}

/* Footer Bottom */
.footer-bottom {
  border-top: 1px solid rgba(255, 204, 0, 0.08);
  padding-top: clamp(0.875rem, 1.75vw, 1.125rem);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.875rem;
  font-size: 0.8125rem;
}

/* Payment Methods */
.payment-methods {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.payment-label {
  color: rgba(148, 163, 184, 0.7);
  font-size: 0.6875rem;
  font-weight: 500;
  white-space: nowrap;
}

.payment-logos {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.payment-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90px;
  height: 38px;
  background: rgba(255, 204, 0, 0.02);
  border: 1px solid rgba(255, 204, 0, 0.1);
  border-radius: 4px;
  padding: 0.5rem;
  transition: all 0.2s ease;
}

.payment-logo:hover {
  background: rgba(255, 204, 0, 0.05);
  border-color: rgba(255, 204, 0, 0.2);
  transform: translateY(-1px);
}

.payment-logo svg {
  width: 100%;
  height: 100%;
  max-width: 24px;
  max-height: 12px;
}

.payment-logo-img {
  width: 100%;
  height: auto;
  max-width: 90px;
  max-height: 38px;
  object-fit: contain;
  filter: brightness(1.1) contrast(1.2);
}

.copyright {
  color: rgba(148, 163, 184, 0.65);
  margin: 0;
  font-size: 0.6875rem;
}

.bottom-nav {
  display: flex;
  gap: 0.875rem;
  align-items: center;
}

.bottom-nav a {
  color: rgba(148, 163, 184, 0.75);
  text-decoration: none;
  font-size: 0.6875rem;
  padding: 0.25rem 0.625rem;
  border-radius: 4px;
  transition: all 0.2s ease;
  position: relative;
}

.bottom-nav a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 1px;
  background: var(--accent, #ffcc00);
  transition: width 0.3s ease;
}

.bottom-nav a:hover {
  color: rgba(255, 204, 0, 0.9);
}

.bottom-nav a:hover::after {
  width: 80%;
}

.bottom-nav a:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Accessibility */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .footer-content {
    padding: 1.25rem 1.125rem 0.875rem 1.125rem;
    gap: 1.125rem;
  }

  .footer-top {
    gap: 1.25rem;
  }

  .links-section {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.125rem;
  }

  .section-title {
    font-size: 0.5625rem;
    margin-bottom: 0.375rem;
  }

  .footer-links a {
    font-size: 0.75rem;
  }

  .footer-bottom {
    font-size: 0.75rem;
    gap: 0.625rem;
    padding-top: 0.75rem;
  }

  .copyright {
    font-size: 0.6875rem;
  }

  .payment-label {
    font-size: 0.6875rem;
  }

  .payment-logo {
    width: 85px;
    height: 36px;
  }

  .bottom-nav {
    gap: 0.75rem;
  }

  .bottom-nav a {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
  }
}

@media (max-width: 768px) {
  .footer-content {
    padding: 1.5rem 1rem 0.875rem 1rem;
    gap: 1.25rem;
  }

  .footer-top {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .links-section {
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .section-title {
    font-size: 0.5625rem;
  }

  .brand-area {
    text-align: center;
    align-items: center;
  }

  .brand-logo-img {
    height: 26px;
  }

  .brand-tagline {
    max-width: none;
    text-align: center;
    font-size: 0.75rem;
  }

  .company-highlights {
    align-items: center;
  }

  .social-links {
    justify-content: center;
    gap: 0.5rem;
  }

  .social-link {
    width: 34px;
    height: 34px;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding-top: 0.875rem;
  }

  .payment-methods {
    order: 2;
    margin: 0.25rem 0;
  }

  .bottom-nav {
    gap: 0.75rem;
  }
}

@media (max-width: 480px) {
  .footer-content {
    padding: 1.25rem 0.875rem 0.75rem 0.875rem;
    gap: 1.125rem;
  }

  .footer-top {
    gap: 1.125rem;
  }

  .links-section {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .links-column {
    text-align: center;
  }

  .section-title {
    text-align: center;
    font-size: 0.5625rem;
    margin-bottom: 0.375rem;
  }

  .footer-links {
    align-items: center;
    gap: 0.1875rem;
  }

  .footer-links a {
    font-size: 0.75rem;
    padding: 0.1875rem 0;
  }

  .brand-logo-img {
    height: 26px;
  }

  .brand-tagline {
    font-size: 0.75rem;
  }

  .company-highlights {
    gap: 0.5rem;
  }

  .highlight-item {
    justify-content: center;
    padding: 0.375rem 0;
    font-size: 0.75rem;
  }

  .highlight-icon {
    width: 26px;
    height: 26px;
  }

  .social-links {
    gap: 0.5rem;
  }

  .social-link {
    width: 36px;
    height: 36px;
  }

  .social-link svg {
    width: 16px;
    height: 16px;
  }

  .footer-bottom {
    gap: 0.875rem;
    padding-top: 0.875rem;
  }

  .bottom-nav {
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .bottom-nav a {
    font-size: 0.75rem;
    padding: 0.1875rem 0.5rem;
  }

  .payment-methods {
    flex-direction: column;
    gap: 0.5rem;
  }

  .payment-label {
    font-size: 0.75rem;
  }

  .payment-logos {
    gap: 0.5rem;
  }

  .payment-logo {
    width: 95px;
    height: 40px;
  }

  .copyright {
    font-size: 0.6875rem;
  }
}

/* Extra Small Mobile Devices - 360px */
@media (max-width: 360px) {
  /* Very compact footer layout */
  .footer-content {
    padding: 1.125rem 0.625rem 0.625rem 0.625rem;
    gap: 1rem;
  }

  /* Compact footer top */
  .footer-top {
    gap: 1rem;
  }

  /* Smaller brand elements */
  .brand-logo-img {
    height: 24px;
  }

  .brand-tagline {
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* Compact company highlights */
  .company-highlights {
    gap: 0.375rem;
  }

  .highlight-item {
    font-size: 0.6875rem;
    padding: 0.25rem 0;
    gap: 0.375rem;
  }

  .highlight-icon {
    width: 22px;
    height: 22px;
  }

  .highlight-icon svg {
    width: 11px;
    height: 11px;
  }

  /* Smaller social links */
  .social-links {
    gap: 0.375rem;
    margin-top: 0.5rem;
  }

  .social-link {
    width: 32px;
    height: 32px;
    border-radius: 5px;
  }

  .social-link svg {
    width: 14px;
    height: 14px;
  }

  /* Compact links section */
  .links-section {
    gap: 0.875rem;
  }

  .section-title {
    font-size: 0.5625rem;
    margin-bottom: 0.375rem;
  }

  .footer-links {
    gap: 0.125rem;
  }

  .footer-links a {
    font-size: 0.6875rem;
    padding: 0.1875rem 0;
  }

  /* Very compact footer bottom */
  .footer-bottom {
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  /* Compact payment methods */
  .payment-methods {
    gap: 0.375rem;
  }

  .payment-label {
    font-size: 0.6875rem;
  }

  .payment-logos {
    gap: 0.375rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .payment-logo {
    width: 85px;
    height: 36px;
    padding: 0.3125rem;
  }

  /* Compact bottom navigation */
  .bottom-nav {
    gap: 0.5rem;
  }

  .bottom-nav a {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.3125rem;
  }

  /* Smaller copyright */
  .copyright {
    font-size: 0.6875rem;
    line-height: 1.3;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .footer {
    border-top-width: 2px;
  }
  
  .footer-links a:focus,
  .bottom-nav a:focus,
  .social-link:focus,
  .brand-logo:focus {
    outline-width: 3px;
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .social-link,
  .footer-links a,
  .bottom-nav a,
  .brand-logo,
  .payment-logo {
    transition: none;
    transform: none !important;
  }

  .footer-links a::before,
  .bottom-nav a::after {
    transition: none;
  }

  .social-link:hover,
  .footer-links a:hover,
  .payment-logo:hover {
    transform: none;
  }
}

/* ========== MACBOOK AIR M2 14" RESPONSIVE DESIGN ========== */
@media (min-width: 1400px) and (max-width: 1600px) and (min-height: 900px) and (max-height: 1100px) {
  /* MacBook Air M2 14" specific optimizations */

  /* Container max-width optimization */
  .footer-content {
    max-width: 1400px;
    padding: 3.5rem 2.25rem 2rem 2.25rem;
    gap: 2.75rem;
  }

  /* Footer top section */
  .footer-top {
    gap: 4rem;
  }

  /* Brand area improvements */
  .brand-tagline {
    font-size: 1rem;
    max-width: 380px;
    line-height: 1.7;
  }

  .brand-logo-img {
    height: 44px;
  }

  /* Company highlights */
  .highlight-item {
    font-size: 0.9375rem;
    padding: 0.625rem 0;
    gap: 1rem;
  }

  .highlight-icon {
    width: 32px;
    height: 32px;
  }

  .highlight-icon svg {
    width: 17px;
    height: 17px;
  }

  /* Social links */
  .social-links {
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .social-link {
    width: 50px;
    height: 50px;
    border-radius: 12px;
  }

  .social-link svg {
    width: 22px;
    height: 22px;
  }

  /* Links section */
  .links-section {
    gap: 2.75rem;
  }

  .section-title {
    font-size: 0.625rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.375rem;
  }

  .footer-links {
    gap: 1rem;
  }

  .footer-links a {
    font-size: 0.9375rem;
    padding: 0.5rem 0;
  }

  /* Footer bottom */
  .footer-bottom {
    padding-top: 2rem;
    gap: 1.75rem;
    font-size: 0.9375rem;
  }

  /* Payment methods */
  .payment-methods {
    gap: 1.25rem;
  }

  .payment-label {
    font-size: 0.875rem;
  }

  .payment-logos {
    gap: 1rem;
  }

  .payment-logo {
    width: 140px;
    height: 58px;
    padding: 0.625rem;
  }

  .copyright {
    font-size: 0.875rem;
  }

  .bottom-nav {
    gap: 2rem;
  }

  .bottom-nav a {
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
  }
}

/* Dark mode enhancements */
@media (prefers-color-scheme: dark) {
  .brand-logo-img {
    opacity: 1;
  }
}